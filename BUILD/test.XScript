SetArgument($a.unconnected, "Unconnected", VARBOOLEAN);
SetArgument($a.reveal, "Reveal?", VARBOOLEAN);
SetVersion(4);
SetDescription("Reveal all sectors and stations");

$Page.ID = getGlobalData("cycrow.cheat.pageid");
$main.universe = getGlobalData("main.universe");
if not ($main.universe->exists())
   $main.universe = getsectorfromidx(0, 0);
if not ($main.universe->exists())
   $main.universe = PLAYERSHIP->getSector();

$x = getMaxSectorX();
while ($x)
{
   $y = getMaxSectorY();
   dec($x);
   while ($y)
   {
      dec($y);

      $sector = getsectorfromidx($x, $y);
      if not ($sector->exists())
         continue ;

      $found.gate = FALSE;

      if ($a.reveal)
      {
         $flags = Find::ExcludeTerranGates | Find::ExcludeGates | Find::Hyperspeed;
         $hsap = findgate($flags, $sector, null, null);
         if ($hsap->exists())
         {
            if ($hsap->objIshsap())
            {
               if not ($hsap->hsapGetdiscover())
               {
                  $dest = $hsap->objGetgatedestination(FALSE);
                  if not ($dest->hsapGetdiscover())
                  {
                     if not (sectorValidroute($main.universe, $sector))
                     {
                        continue ;
                     }
                  }
               }
            }
         }
      }

      wait(1);

      $gate.id = 6;
      while ($gate.id)
      {
         dec($gate.id);
         $gate = $sector->getGate($gate.id);
         if not ($gate->exists())
            continue ;

         if not ($gate->objIshsap())
         {
            $gate->objSetknown($a.reveal);
            if ($a.reveal)
               $gate->shipSethidden(FALSE);
         }
         $found.gate = TRUE;
      }

      if ($a.reveal && $found.gate)
      {
// allow for terran sectors if unconnected
         $sector.owner = $sector->getOwner();
         if (!$a.unconnected || $sector.owner != Terran)
         {
            if not (sectorValidroute($main.universe, $sector))
               continue ;
         }
      }

      if ($found.gate || $a.unconnected)
      {
         $sector->objSetknown($a.reveal);
         $stations = $sector->secGetstations();
         $size = arraySize($stations);
         while ($size)
         {
            dec($size);
            $s = $stations[$size];
            $s->objSetknown($a.reveal);
         }

         $astros = $sector->secGetasteroids();
         $size = arraySize($astros);
         while ($size)
         {
            dec($size);
            $a = $astros[$size];
            $a->objSetknown($a.reveal);
         }
      }

   }
}
return null;
